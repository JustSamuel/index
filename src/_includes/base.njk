<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>

<style>
:root{
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial;
  --sw:300px;
  --gap:30px;
}

body{
  margin:0;
  padding:20px;
  line-height:1.5;
  background-color:#0D141D;
  color:#E0E0E0;
}

.page{
  max-width:1100px;
  margin:0 auto;
}

.layout{
  display:flex;
  gap:var(--gap);
  min-height:100vh;
  justify-content: center;
}

.sidebar{
  position:sticky;
  top:20px;
  max-height:calc(100vh - 40px);
  min-width:300px;
  overflow:auto;
  padding-right:12px;
  margin-right:40px;
}

.sidebar ul {
  list-style:none;
  padding:0;
  margin:0;
}

.sidebar li {
  margin-bottom:1.2em;
}

.sidebar li a {
  display:block; 
  text-decoration:none;
  color:inherit; 
  border-radius:4px; 
  transition: background 0.2s;
}

.sidebar li a:hover {
  background-color: rgba(255, 255, 255, 0.05); 
}

.sidebar-tooltip {
  font-size: 0.85rem;
  color: #AAAAAA;
  margin-top: 0.25em;
  line-height:1.4;
}

.content{
  max-width:80ch;
  text-align: justify;
}

h1{font-size:1.75rem;mcolor:#FFFFFF}
h2{font-size:1.1rem;margin:1.5rem 0 0.75rem;color:#DDDDDD}
a:not(.sidebar li a){color:#4EA1FF;text-decoration:underline}

.back{font-size:.85rem;margin:0 0 1rem;display:block}
.back a{color:#AAAAAA;text-decoration:none}
.back a:hover{text-decoration:underline}
.meta{font-size:.85rem;color:#AAAAAA;margin:0 0 1.5rem;line-height:1.6}

code{
  background:#1B2430;
  color:#F5F5F5;
  padding:.15em .4em;
  border-radius:3px;
  font-size:.9em;
  font-family:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace;
}
pre{
  background:#1B2430;
  color:#F5F5F5;
  padding:1em;
  border-radius:4px;
  overflow-x:auto;
  margin:1.5rem 0;
}
pre code{background:none;padding:0;font-size:.9em}

.footnotes{
  margin-top:3rem;
  padding-top:1.5rem;
  border-top:1px solid #2A2F3B;
}

hr {border:none;border-top:1px solid #2A2F3B;margin:1em 0}

@media(max-width:700px){
  .layout{
    flex-direction:column-reverse;
    justify-content:start;
  }
  .sidebar{
    position:relative;
    max-height:none;
    border-right:none;
    margin-bottom:20px;
  }
}
</style>

<div class="page">
  <main class="layout">
    <nav class="sidebar" aria-label="Notes list">
      <h1>Entries</h1>
      <hr>
      <ul class="note-list">
        <li>
          <a href="/">
            <div><b>About Index</b></div>
          </a>
          <hr>
        </li>
        {% for note in collections.notes | sortByTitle %}
          <li>
            <a href="{{ note.url }}">
              <div><b>{{ note.data.title }}</b></div>
              {% if note.data.summary %}
                <div class="sidebar-tooltip">{{ note.data.summary }}</div>
              {% endif %}
            </a>
          </li>
          <hr>
        {% endfor %}
      </ul>
    </nav>

    <section class="content">
      {% block content %}{% endblock %}
    </section>
  </main>
</div>
