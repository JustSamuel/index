
<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>

<style>
:root{
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial;
  --sw:300px;
  --gap:30px; }

body{
  margin:0;
  padding:20px;
  line-height:1.5;
  color:#0a0a0a;
}

.page{
  max-width:1100px;
  margin:0 auto;
}

.layout{
  display:flex;
  gap:var(--gap);
  min-height:100vh;
  justify-content: center;
}

.sidebar{
  position:sticky;
  top:20px;
  max-height:calc(100vh - 40px);
  min-width:300px;
  overflow:auto;
  padding-right:12px;
  border-right:1px solid #eee;
}

.sidebar ul {
  list-style:none;
  padding:0;
  margin:0;
}

.sidebar li {
  margin-bottom:1.2em; /* increased spacing */
}

.sidebar-tooltip {
  font-size: 0.85rem;
  color: #666;
  margin-top: 0.25em;
  line-height:1.4;
}

.content{
  max-width:80ch;
  text-align: justify;
}

h1{font-size:1.75rem;margin:0 0 1rem}
h2{font-size:1.1rem;margin:1.5rem 0 0.75rem}
a{color:#0066cc;text-decoration:underline}

.back{font-size:.85rem;margin:0 0 1rem;display:block}
.back a{color:#666;text-decoration:none}
.back a:hover{text-decoration:underline}
.meta{font-size:.85rem;color:#666;margin:0 0 1.5rem;line-height:1.6}

code{background:#f5f5f5;padding:.15em .4em;border-radius:3px;font-size:.9em;font-family:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace}
pre{background:#f5f5f5;padding:1em;border-radius:4px;overflow-x:auto;margin:1.5rem 0}
pre code{background:none;padding:0;font-size:.9em}
.footnotes{margin-top:3rem;padding-top:1.5rem;border-top:1px solid #e0e0e0}

hr {border:none;border-top:1px solid #ddd;margin:1em 0}

@media(max-width:700px){
  .layout{
    flex-direction:column-reverse;
    justify-content:start;
  }
  .sidebar{
    position:relative;
    max-height:none;
    border-right:none;
    margin-bottom:20px;
  }
}
</style>

<div class="page">
  <main class="layout">
    <nav class="sidebar" aria-label="Notes list">
      <h1>Entries</h1>
      <hr>
      <ul class="note-list">
        <li>
          <a href="/">Index</a>
        </li>
        {% for note in collections.notes | sortByTitle %}
          <li>
            <a href="{{ note.url }}"{% if note.data.tooltip %} title="{{ note.data.tooltip }}"{% endif %}>
              {{ note.data.title }}
            </a>
            {% if note.data.summary %}
              <div class="sidebar-tooltip">{{ note.data.summary }}</div>
            {% endif %}
          </li>
          <hr>
        {% endfor %}
      </ul>
    </nav>

    <section class="content">
      {% block content %}{% endblock %}
    </section>
  </main>
</div>
