<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
<style>
:root{font-family:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial}
body{margin:20px;line-height:1.4;color:#0a0a0a}
main{max-width:80ch;margin:0 auto; text-align: justify}
h1{font-size:1.75rem;margin:0 0 1rem}
h2{font-size:1.1rem;margin:1.5rem 0 .75rem}
a{color:#0066cc;text-decoration:underline}
.items{columns:2;column-gap:2rem;margin:1rem 0}
.items li{margin:.25rem 0;break-inside:avoid}
@media(max-width:600px){.items{columns:1}}
code{background:#f5f5f5;padding:.15em .4em;border-radius:3px;font-size:.9em;font-family:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace}
pre{background:#f5f5f5;padding:1em;border-radius:4px;overflow-x:auto;margin:1.5rem 0}
pre code{background:none;padding:0;font-size:.9em}
</style>
<main>
  <header>
    <h1>{{ title }}</h1>
  </header>
  {{ content | safe }}
</main>

