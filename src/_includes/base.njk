<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>

<style>
:root{
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial;
  --sw:300px;
  --gap:30px;
}

body{
  margin:0;
  padding:0;
  line-height:1.75;
  background-color:#0D141D;
  color:#E0E0E0;
}

.page{
  max-width:1100px;
  margin:0 auto;
  padding:20px;
  padding-top:80px; }

.layout{
  display:flex;
  gap:var(--gap);
  align-items:flex-start; }

.sidebar{
  position:sticky;
  top:20px;
  max-height:calc(100vh - 40px);
  min-width:300px;
  overflow:auto;
  padding-right:12px;
  background:#0D141D;
  transition: transform 0.2s ease;
  z-index:50;
}

/* Desktop spacing */
@media(min-width:701px){
  .sidebar{
    margin-right:40px;
    padding-left:12px;
  }
}

.sidebar ul {
  list-style:none;
  padding:0;
  margin:0;
}

.sidebar li {
  margin-bottom:1.2em;
}

.sidebar li a {
  display:block; 
  text-decoration:none;
  color:inherit; 
  border-radius:4px; 
  transition: background 0.2s;
}

.sidebar li a:hover {
  background-color: rgba(255, 255, 255, 0.05); 
}

.sidebar-tooltip {
  font-size: 0.85rem;
  color: #AAAAAA;
  margin-top: 0.25em;
  line-height:1.4;
}

.content{
  max-width:80ch;
  text-align: justify;
}

h1{font-size:1.75rem;color:#FFFFFF}
h2{font-size:1.1rem;margin:1.5rem 0 0.75rem;color:#DDDDDD}
a:not(.sidebar li a){color:#c49300;text-decoration:underline}

.back{font-size:.85rem;margin:0 0 1rem;display:block}
.back a{color:#AAAAAA;text-decoration:none}
.back a:hover{text-decoration:underline}
.meta{font-size:.85rem;color:#AAAAAA;margin:0 0 1.5rem;line-height:1.6}

code{
  background:#1B2430;
  color:#F5F5F5;
  padding:.15em .4em;
  border-radius:3px;
  font-size:.9em;
  font-family:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace;
}
pre{
  background:#1B2430;
  color:#F5F5F5;
  padding:1em;
  border-radius:4px;
  overflow-x:auto;
  margin:1.5rem 0;
}
pre code{background:none;padding:0;font-size:.9em}

.footnotes{
  margin-top:3rem;
  padding-top:1.5rem;
  border-top:1px solid #2A2F3B;
}

hr {border:none;border-top:1px solid #2A2F3B;margin:1em 0}

.topbar{
  position:fixed;
  top:0;
  left:0;
  width:100%;
  height:60px;
  background:#111827;   
  display:flex;
  align-items:center;
  padding:0 20px;
  z-index:100;
  box-shadow: 0 2px 6px rgba(0,0,0,0.3);
  display:none;
}

.hamburger{
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  width:30px;
  height:22px;
  cursor:pointer;
}
.hamburger div{
  height:4px;
  background:#E0E0E0;
  border-radius:2px;
}

@media(max-width:700px){
  .topbar{
    display:flex; /* show only on mobile */
  }
  .page{
    padding-top:80px; /* space for topbar on mobile */
  }
  .layout{
    flex-direction:column;
  }
  .sidebar{
    position:fixed;
    top:0;
    left:0;
    height:100%;
    width:80%;
    transform:translateX(-110%);
    box-shadow: 2px 0 8px rgba(0,0,0,0.5);
    margin:0;
    padding:20px;
  }
  .sidebar.active{
    transform:translateX(0);
  }
}
</style>

<!-- Full-width topbar only shows on mobile -->
<div class="topbar">
  <div class="hamburger" onclick="document.querySelector('.sidebar').classList.toggle('active')">
    <div></div>
    <div></div>
    <div></div>
  </div>
</div>

<div class="page">
  <main class="layout">
    <nav class="sidebar" aria-label="Notes list">
      <h1 style="opacity:0;">Entries</h1>
      <hr>
      <ul class="note-list">
        <li>
          <a href="/">
            <div><b>About Index</b></div>
          </a>
          <hr>
        </li>
        {% for note in collections.notes | sortByTitle %}
          <li>
            <a href="{{ note.url }}">
              <div><b>{{ note.data.title }}</b></div>
              {% if note.data.summary %}
                <div class="sidebar-tooltip">{{ note.data.summary }}</div>
              {% endif %}
            </a>
          </li>
          <hr>
        {% endfor %}
      </ul>
    </nav>

    <section class="content">
      {% block content %}{% endblock %}
    </section>
  </main>
</div>
