<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title | default("My Huh") }}</title>
<style>
/* inline critical CSS - keep this tiny */
:root{font-family:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial}
body{margin:20px;line-height:1.4;color:#0a0a0a}
main{max-width:80ch;margin:0 auto}
h1{font-size:1.75rem;margin:0 0 .5rem}
h2{font-size:1.1rem;margin:1.5rem 0 .75rem}
a{color:#0066cc;text-decoration:underline}
.back{font-size:.85rem;margin:0 0 1rem;display:block}
.back a{color:#666;text-decoration:none}
.back a:hover{text-decoration:underline}
.meta{font-size:.85rem;color:#666;margin:0 0 1.5rem;line-height:1.6}
.meta span{margin-right:.75em}
.meta span:not(:last-child)::after{content:"·";margin-left:.75em;color:#999}
</style>
<main>
  <div class="back"><a href="/">← back</a></div>
  <header>
    <h1>{{ title }}</h1>
    {% if date or tags %}
    <div class="meta">
      {% if date %}<span>{{ date | formatDate("yyyy-MM-dd") }}</span>{% endif %}
      {% if tags %}
        {% set tagList = tags %}
        {% if tagList is string %}{% set tagList = [tags] %}{% endif %}
        {% for tag in tagList %}
          <span>{{ tag }}</span>
        {% endfor %}
      {% endif %}
    </div>
    {% endif %}
  </header>
  {{ content | safe }}
</main>

